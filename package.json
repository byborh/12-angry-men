{
  "name": "12-angry-men",
  "version": "0.1.0",
  "description": "See which of your Claude Code skills you really use. Local, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "12-angry-men": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "demo": "node src/cli.ts --demo",
    "check": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
